APP_NAME=Campus Innovators API
ENVIRONMENT=development
DATABASE_URL=sqlite:///./campus_v2.db
SECRET_KEY=replace-with-at-least-64-random-characters
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=campus_refresh
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
FOUNDER_EMAIL=campusinnovators07@gmail.com
FOUNDER_USERNAME=campusinnovator
FOUNDER_NAME="Campus Innovator"
FOUNDER_DEPARTMENT="Computer Science & Engineering"
FOUNDER_YEAR="2nd Year"
FOUNDER_PASSWORD=replace-with-a-strong-founder-password
# Fills an empty local database with fictional demo members/posts/projects
# so the UI isn't blank. Set to true only for local development or a public
# demo deployment — never for real production (config.py refuses to start
# with this on when ENVIRONMENT=production).
SEED_DEMO_DATA=true
INTRO_VIDEO_URL=
# Leave blank to allow all valid email domains during development.
ALLOWED_EMAIL_DOMAINS=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
TRUST_PROXY_HEADERS=false
# Optional: only needed when running multiple backend instances so rate limits are shared
# across them instead of tracked per-process. Leave unset for local/single-instance dev.
REDIS_URL=
