APP_NAME=Campus Innovators API
ENVIRONMENT=production

# Render's Postgres "Internal Database URL" starts with postgresql://
# This backend uses the psycopg v3 driver, so you MUST change the prefix by hand:
#   postgresql://user:pass@host/db  -->  postgresql+psycopg://user:pass@host/db
# Forgetting this makes the container fail on startup.
DATABASE_URL=postgresql+psycopg://replace-with-render-internal-db-url

# Generate with: python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-at-least-64-random-characters

ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
REFRESH_COOKIE_NAME=campus_refresh

# Frontend (Vercel) and backend (Render) live on different domains, so this is
# a cross-site deployment. That combination is required for the browser to
# accept and send the refresh cookie at all:
COOKIE_SECURE=true
COOKIE_SAMESITE=none
# Leave COOKIE_DOMAIN blank for cross-site — a shared parent domain doesn't exist here.
COOKIE_DOMAIN=

FOUNDER_EMAIL=campusinnovators07@gmail.com
FOUNDER_USERNAME=campusinnovator
FOUNDER_NAME="Campus Innovator"
FOUNDER_DEPARTMENT="Computer Science & Engineering"
FOUNDER_YEAR="2nd Year"
# 12+ chars, upper + lower + a digit — enforced at startup in production.
FOUNDER_PASSWORD=replace-with-a-strong-founder-password

# Must stay false in production — startup will refuse to boot otherwise.
# The real account is created once via `python -m app.bootstrap_admin`
# (see step 5 of DEPLOY_RENDER_VERCEL.md), not via demo seeding.
SEED_DEMO_DATA=false
INTRO_VIDEO_URL=

# Leave blank to allow any email domain to self-register (still gated by the
# admin allowlist). Set to your college domain(s) to also restrict by domain.
ALLOWED_EMAIL_DOMAINS=

# Your Vercel production domain, and any preview domains you want to allow.
# Comma-separated, no trailing slashes.
CORS_ORIGINS=https://your-app.vercel.app

# Your Render backend's own public hostname (shown on the Render service page).
TRUSTED_HOSTS=your-backend.onrender.com

# Render sits behind a proxy, so trust its X-Forwarded-For header for the
# rate limiter to key on the real client IP instead of Render's proxy IP.
TRUST_PROXY_HEADERS=true

# Render "Key Value" instance or Upstash Redis — internal connection string.
# Without this, rate limiting falls back to in-memory (per-instance) tracking.
REDIS_URL=replace-with-render-or-upstash-redis-url

# Optional. Powers the "Upload" button next to avatar image URLs in
# Settings (admin-only). Get these from cloudinary.com → Dashboard → free
# tier is enough. If left blank, uploads are disabled and admins can still
# paste an image URL manually.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Used to build the password-reset link that gets emailed/console-logged.
# Must be your Vercel frontend URL, not the backend URL.
FRONTEND_URL=https://your-app.vercel.app
